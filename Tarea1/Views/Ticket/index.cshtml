

@{
    ViewBag.Title = "Reporte";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Ticket</title>
</head>
<body>


    <div class="container mt-4">

 
        <h2 class="mb-4">Reporte</h2>

  

        <div class="row mb-4">

            <div class="col-md-3 mb-3">
                <div class="card text-center shadow-sm p-3">
                    <h5>Total Tickets</h5>
                    <h2 id="totalTicket">0</h2>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center shadow-sm p-3">
                    <h5>Incidencias Pendientes</h5>
                    <h2 id="pTotalTicket">0</h2>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center shadow-sm p-3">
                    <h5>Incidencias Abiertas</h5>
                    <h2 id="pendingTotalTicket">0</h2>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center shadow-sm p-3">
                    <h5>Incidencias Cerradas</h5>
                    <h2 id="solveTotalTicket">0</h2>
                </div>
            </div>

        </div>



        <div class="mb-4">
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalTicket">
                Agregar incidencia
            </button>
        </div>


        <div class="mb-3">
            <h4>Tickets agregados</h4>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Usuario</th>
                        <th>Título</th>
                        <th>Descripción</th>
                        <th>Fecha de creación</th>
                        <th>Departamento</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody id="tablaTickets">
                </tbody>
            </table>
        </div>

    </div>


    <div class="modal fade" id="modalTicket" tabindex="-1"
         aria-labelledby="tituloModalTicket" aria-hidden="true">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModalTicket">
                        Agregar incidencia
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <form id="formTicket">

                   
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Usuario</label>
                                <input type="text" class="form-control"
                                       id="userName" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Título</label>
                                <input type="text" class="form-control"
                                       id="tittle" required>
                            </div>
                        </div>

                       
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Departamento</label>
                                <select id="deparment" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="TI">TI</option>
                                    <option value="Soporte">Soporte</option>
                                    <option value="Administración">Administración</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Prioridad</label>
                                <select id="priority" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Alta">Alta</option>
                                    <option value="Media">Media</option>
                                    <option value="Baja">Baja</option>
                                </select>
                            </div>
                        </div>

                     
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Estado</label>
                                <select id="status" class="form-select" required>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="En proceso">En proceso</option>
                                    <option value="Cerrado">Cerrado</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Descripción</label>
                                <textarea id="description"
                                          class="form-control"
                                          rows="2" required></textarea>
                            </div>
                        </div>

                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" form="formTicket"
                            class="btn btn-primary" id="btnGuardarTicket">
                        Guardar incidencia
                    </button>
                </div>

            </div>
        </div>
    </div>


</body>
@section Scripts {
    <script src="@Url.Content("~/Scripts/Ticket.js")"></script>
    <script src="@Url.Content("~/Scripts/validator.js")"></script>
}
</html>
